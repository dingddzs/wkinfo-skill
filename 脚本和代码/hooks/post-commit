#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
Git post-commit hook: 每次 commit 后自动把项目文件同步到 skill 安装位置

触发条件：git commit 完成后
作用：直接调用 scripts/sync.py 的 sync_push() 函数（避免 subprocess 编码问题）
可跳过：git commit --no-verify（不绕过这个钩子；用 SKIP_AUTO_SYNC=1 跳过）
退出码：0=同步成功/跳过，1=同步失败（commit 仍然成功，不会回滚）
"""
import os
import subprocess
import sys
import importlib.util
from pathlib import Path

# 通过 git rev-parse 找项目根（hook 装在 .git/hooks/，相对路径不固定）
try:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True, timeout=5,
        encoding="utf-8", errors="replace"
    )
    PROJECT_ROOT = Path(result.stdout.strip())
except Exception:
    PROJECT_ROOT = Path.cwd()

SYNC_SCRIPT = PROJECT_ROOT / "脚本和代码" / "sync.py"


def load_sync_module():
    """动态加载 sync.py（无 .py 扩展也可加载）"""
    spec = importlib.util.spec_from_file_location("sync_module", str(SYNC_SCRIPT))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def main():
    # 支持 SKIP_AUTO_SYNC=1 跳过
    if os.environ.get("SKIP_AUTO_SYNC") == "1":
        return 0

    if not SYNC_SCRIPT.exists():
        print(f"[post-commit-hook] WARNING: sync.py not found at {SYNC_SCRIPT}")
        return 0

    # 跳过 sync 自身/钩子文件的 commit（避免无限循环）
    try:
        result = subprocess.run(
            ["git", "log", "-1", "--name-only", "--pretty=format:"],
            cwd=PROJECT_ROOT,
            capture_output=True, text=True, timeout=5,
            encoding="utf-8", errors="replace"
        )
        changed_files = [f for f in result.stdout.strip().split("\n") if f]
        if changed_files and all(
            f.endswith("sync.py") or f.endswith("hooks/post-commit") or f.endswith("install_hooks.py")
            for f in changed_files
        ):
            return 0
    except Exception:
        pass

    # 加载 sync 模块并直接调用 sync_push()（避免 subprocess 编码问题）
    try:
        sync_mod = load_sync_module()
        synced, _ = sync_mod.sync_push(dry_run=False)
        if synced:
            # 显示简短摘要
            print(f"[post-commit-hook] auto-synced {len(synced)} file(s):")
            for line in synced[:5]:
                print(f"  {line}")
            if len(synced) > 5:
                print(f"  ... +{len(synced) - 5} more")
        else:
            print(f"[post-commit-hook] already in sync (no changes)")
    except Exception as e:
        print(f"[post-commit-hook] ERROR: {e}")
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
